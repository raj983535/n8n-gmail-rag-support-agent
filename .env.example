# ==============================================================================
# n8n Gmail RAG Support Agent - Environment Configuration Example
# ==============================================================================
# Copy this file to .env and configure your credentials:
# cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. OpenAI API Configuration (For Embeddings and GPT-4o Agent)
# ------------------------------------------------------------------------------
# Get your API key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-YourDemoOpenAiApiKeyHere1234567890
OPENAI_CHAT_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# ------------------------------------------------------------------------------
# 2. Pinecone Vector Database Configuration
# ------------------------------------------------------------------------------
# Create an account at: https://www.pinecone.io/
# CRITICAL: When creating your index in Pinecone, set:
# - Dimensions: 3072 (for OpenAI text-embedding-3-large)
# - Metric: cosine
PINECONE_API_KEY=pcsk_demoPineconeApiKeyHere1234567890
PINECONE_INDEX_NAME=customer-support-rag

# ------------------------------------------------------------------------------
# 3. Google Cloud / Gmail OAuth2 Configuration
# ------------------------------------------------------------------------------
# Set up in Google Cloud Console -> APIs & Services -> Credentials
# Authorized Redirect URI: https://<your-n8n-domain>/rest/oauth2-credential/callback
GMAIL_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GMAIL_CLIENT_SECRET=GOCSPX-your-google-oauth-client-secret

# ------------------------------------------------------------------------------
# 4. Global Settings
# ------------------------------------------------------------------------------
GENERIC_TIMEZONE=Asia/Kolkata
